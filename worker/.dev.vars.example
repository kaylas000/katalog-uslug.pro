# Скопируйте в .dev.vars (файл в .gitignore).
# Вариант без Hyperdrive: wrangler dev подставит строку в Worker.
# В продакшене используйте только Hyperdrive, не секрет DATABASE_URL.

DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/katalog

# --- Идентификация (опционально) ---
# AUTH_PEPPER=случайная-длинная-строка-для-SMS-кодов
# RESEND_API_KEY=re_...
# EMAIL_FROM=Katalog <noreply@ваш-домен>
# DEV_RETURN_EMAIL_LINK=true
# SMSRU_API_ID=...
# YANDEX_CLIENT_ID=...
# YANDEX_CLIENT_SECRET=...
# YANDEX_REDIRECT_URI=https://...workers.dev/v1/auth/oauth/yandex/callback
# PUBLIC_SITE_URL=https://katalog-uslug.pro
# ESIA_CLIENT_ID=...
