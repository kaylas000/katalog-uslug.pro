# Скопируйте в wrangler.local.toml (файл в .gitignore) и подставьте свои значения.
# wrangler dev объединяет этот файл с wrangler.toml.
#
# id — из вывода: npx wrangler hyperdrive list
# (тот же конфиг, что в проде; local_connection_string подменяет хост только на вашем ПК)

[[hyperdrive]]
binding = "HYPERDRIVE"
id = "PASTE_HYPERDRIVE_CONFIG_ID"
local_connection_string = "postgres://USER:PASSWORD@127.0.0.1:5432/katalog"
